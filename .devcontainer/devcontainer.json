{
  "image": "iarsystems/bxarm:9.70.4",
  "mounts": [
    "type=volume,src=LMS2,dst=/usr/local/etc/IARSystems"
  ],

  // Set the Container's environment variables
  "containerEnv": {
    "HOME": "/home/ubuntu",
  },

  // Customizations installs the IAR Extensions for VS Code
  // More information: https://iar.com/vscode
  "customizations": {
    "vscode": {
      "extensions": [
        //"iarsystems.iar-extension-pack",
        "iarsystems.iar-debug",
        "iarsystems.iar-login",
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode-remote.vscode-remote-extensionpack",
        "github.vscode-github-actions"
      ]
    }
  },

  // The License Management System is updated
  //  for the Dev Container at build-time.
  "features": {
    "./jlink": {}
  },

  // Comment "remoteUser" and rebuild the container to become `root`.
  // More information: https://containers.dev/implementors/json_reference/#remoteUser
  "remoteUser": "ubuntu",

  // Exposes the host's USB bus to the dev container.
  "runArgs": [
    "--device=/dev/bus/usb"
  ],
  "privileged": true,

  // Initialize git submodules
  "postCreateCommand": "git submodule update --init --recursive"
}
